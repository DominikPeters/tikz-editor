{
  "name": "tikz-editor",
  "version": "0.3.0",
  "description": "WYSIWYG editor foundations for TikZ",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "codespaces:startup": "bash scripts/codespaces/startup.sh",
    "version:bump": "node scripts/bump-version.mjs",
    "generate:grammar": "npm run -w @tikz-editor/core generate:grammar",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/full/ --cache-strategy content",
    "lint:prod": "eslint . --cache --cache-location node_modules/.cache/eslint/prod/ --cache-strategy content --max-warnings=0 --ignore-pattern 'coverage/**' --ignore-pattern 'test/**' --ignore-pattern 'apps/desktop/e2e/**' --ignore-pattern 'apps/web/e2e/**' --ignore-pattern 'apps/web/profiling/**' --ignore-pattern 'scripts/**' --ignore-pattern 'tools/**' --ignore-pattern 'apps/*/scripts/**' --ignore-pattern 'apps/*/src-tauri/target/**' --ignore-pattern '**/*.config.*' --ignore-pattern '**/tmp-*'",
    "lint:no-unnecessary-condition": "eslint . --no-cache --format json --output-file node_modules/.cache/eslint/no-unnecessary-condition.json --rule '@typescript-eslint/no-unnecessary-condition:warn' --ignore-pattern 'coverage/**' --ignore-pattern 'test/**' --ignore-pattern 'apps/desktop/e2e/**' --ignore-pattern 'apps/web/e2e/**' --ignore-pattern 'apps/web/profiling/**' --ignore-pattern 'scripts/**' --ignore-pattern 'tools/**' --ignore-pattern 'apps/*/scripts/**' --ignore-pattern 'apps/*/src-tauri/target/**' --ignore-pattern '**/*.config.*' --ignore-pattern '**/tmp-*'",
    "lint:test": "eslint test apps/web/e2e apps/web/profiling apps/desktop/e2e --cache --cache-location node_modules/.cache/eslint/test/ --cache-strategy content --max-warnings=0",
    "lint:ci": "npm run lint:prod",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo && node scripts/check-coordinate-typing.mjs",
    "build": "npm run -w @tikz-editor/core build",
    "test": "npm run generate:grammar && vitest run",
    "test:coverage": "npm run generate:grammar && vitest run --coverage",
    "test:capabilities": "npm run generate:grammar && vitest run test/capabilities.spec.ts",
    "test:watch": "npm run generate:grammar && vitest",
    "test:corpus": "npm run generate:grammar && vitest run test/corpus.spec.ts",
    "parse:corpus": "npm run test:corpus",
    "compare:renderers": "node scripts/compare-tikz-renderers.mjs",
    "compare:paragraph-breaks": "node scripts/compare-paragraph-breaks.mjs",
    "compare:paragraph-matrix": "node scripts/compare-paragraph-breaks.mjs --fuzz 400 --seed 20260609 --alignments left,right,center,justify --widths 60,80,100,120,160,200,240,320 --min-words 20 --max-words 90 --out-dir artifacts/paragraph-matrix-compare --oracle-cache-dir artifacts/paragraph-oracle-cache",
    "compare:paragraph-math-matrix": "node scripts/compare-paragraph-breaks.mjs --fuzz 120 --inline-math-fuzz --seed 20260614 --alignments left,justify --widths 120,160,200,240,320 --min-words 18 --max-words 70 --out-dir artifacts/paragraph-math-matrix-compare --oracle-cache-dir artifacts/paragraph-math-oracle-cache",
    "compare:tex-text-visual-fuzz": "node scripts/compare-tex-text-visual-fuzz.mjs",
    "compare:tex-paragraph": "node scripts/compare-tex-paragraph.mjs",
    "compare:tex-shaping": "node scripts/compare-tex-shaping.mjs",
    "compare:tex-text-rendering": "node scripts/compare-tex-text-rendering.mjs",
    "compare:tex-text-visual-fuzz:smoke": "node scripts/compare-tex-text-visual-fuzz.mjs --cases 40 --seed 20260608 --scale 8 --out-dir artifacts/tex-text-svgtrace-fuzz-smoke --cache-dir artifacts/tex-text-svgtrace-cache",
    "compare:tex-text-visual-fuzz:ligatures": "node scripts/compare-tex-text-visual-fuzz.mjs --case-mode ligatures --cases 32 --seed 20260608 --scale 8 --out-dir artifacts/tex-text-svgtrace-fuzz-ligatures --cache-dir artifacts/tex-text-svgtrace-cache",
    "compare:tex-text-visual-fuzz:quote": "node scripts/compare-tex-text-visual-fuzz.mjs --case-mode quote --cases 32 --seed 20260608 --scale 8 --out-dir artifacts/tex-text-svgtrace-fuzz-quote --cache-dir artifacts/tex-text-svgtrace-cache-quote",
    "compare:tex-text-visual-fuzz:style": "node scripts/compare-tex-text-visual-fuzz.mjs --case-mode style --cases 40 --seed 20260608 --scale 8 --out-dir artifacts/tex-text-svgtrace-fuzz-style --cache-dir artifacts/tex-text-svgtrace-cache-style",
    "compare:tex-text-visual-fuzz:list": "node scripts/compare-tex-text-visual-fuzz.mjs --case-mode list --cases 40 --seed 20260608 --scale 8 --out-dir artifacts/tex-text-svgtrace-fuzz-list --cache-dir artifacts/tex-text-svgtrace-cache-list",
    "compare:tex-text-visual-fuzz:mixed": "node scripts/compare-tex-text-visual-fuzz.mjs --case-mode mixed --cases 60 --seed 20260608 --scale 8 --out-dir artifacts/tex-text-svgtrace-fuzz-mixed --cache-dir artifacts/tex-text-svgtrace-cache-mixed",
    "compare:tex-text-visual-fuzz:large": "node scripts/compare-tex-text-visual-fuzz.mjs --cases 200 --seed 20260608 --scale 8 --out-dir artifacts/tex-text-svgtrace-fuzz-large --cache-dir artifacts/tex-text-svgtrace-cache",
    "compare:tex-math": "node scripts/compare-tex-math.mjs",
    "compare:tex-math:fuzz": "node scripts/compare-tex-math.mjs --math-fuzz 40 --seed 20260615 --summary-only",
    "compare:tex-math:fuzz:large": "node scripts/compare-tex-math.mjs --math-fuzz 160 --seed 20260616 --summary-only",
    "compare:tex-math:aligned-fuzz": "node scripts/compare-tex-math.mjs --aligned-fuzz 64 --seed 20260615 --summary-only",
    "compare:tex-math:aligned-fuzz:large": "node scripts/compare-tex-math.mjs --aligned-fuzz 160 --seed 20260616 --summary-only",
    "compare:tex-inline-math-paragraph": "node scripts/compare-tex-inline-math-paragraph.mjs --summary-only",
    "compare:tex-inline-math-paragraph:fuzz": "node scripts/compare-tex-inline-math-paragraph.mjs --fuzz 64 --seed 20260615 --summary-only --oracle-cache-dir artifacts/tex-inline-math-paragraph-oracle-cache",
    "compare:tex-display-math": "node scripts/compare-tex-display-math.mjs --tolerance 0.03",
    "compare:tex-display-math:align-matrix": "node scripts/compare-tex-display-math.mjs --align-matrix --summary-only --tolerance 0.03",
    "compare:tex-display-math:construct-matrix": "node scripts/compare-tex-display-math.mjs --construct-matrix --summary-only --tolerance 0.03",
    "compare:tex-display-math:fuzz": "node scripts/compare-tex-display-math.mjs --display-fuzz 64 --seed 20260615 --summary-only --tolerance 0.03",
    "compare:tex-display-math:fuzz:large": "node scripts/compare-tex-display-math.mjs --display-fuzz 192 --seed 20260616 --summary-only --tolerance 0.03",
    "compare:arrows": "node scripts/compare-arrow-fixtures.mjs",
    "compare:pgf-docs": "node scripts/compare-pgf-docs-renderings.mjs",
    "compare:kottwitz-book": "node scripts/compare-pgf-docs-renderings.mjs --mode kottwitz-book",
    "compare:kolda-book": "node scripts/compare-pgf-docs-renderings.mjs --mode kolda-book",
    "harvest:beamer-corpus": "node scripts/harvest-beamer-corpus.mjs",
    "scan:beamer-corpus": "node scripts/scan-beamer-corpus.mjs",
    "generate:font-previews": "node scripts/generate-font-previews.mjs",
    "generate:shape-previews": "npx tsx apps/web/scripts/generate-node-shape-previews.ts",
    "debug:multiline": "npm run -w @tikz-editor/web debug:multiline --",
    "bench:incremental-drag": "node scripts/benchmark-incremental-drag.mjs",
    "profile:web": "npm run -w @tikz-editor/web profile --",
    "profile:web:analyze": "npm run -w @tikz-editor/web profile:analyze --",
    "profile:web:compare": "npm run -w @tikz-editor/web profile:compare --",
    "profile:web:compare-report": "npm run -w @tikz-editor/web profile:compare-report --",
    "dev:web": "npm run -w @tikz-editor/web dev",
    "predev:tex-paragraph-lab": "npm run -w @tikz-editor/core build",
    "dev:tex-paragraph-lab": "node tools/tex-paragraph-lab/server.mjs",
    "dev:landing": "npm run -w @tikz-editor/landing dev",
    "dev:desktop": "npm run -w @tikz-editor/desktop tauri:dev",
    "build:landing": "npm run -w @tikz-editor/landing build",
    "capture:landing-screenshots": "npm run -w @tikz-editor/landing capture:screenshots --",
    "build:desktop": "npm run -w @tikz-editor/desktop tauri:build",
    "test:e2e": "npm run -w @tikz-editor/web test:e2e --",
    "test:e2e:firefox": "npm run -w @tikz-editor/web test:e2e:firefox --",
    "test:e2e:webkit": "npm run -w @tikz-editor/web test:e2e:webkit --",
    "test:e2e:all-browsers": "npm run -w @tikz-editor/web test:e2e:all-browsers --",
    "test:e2e:ci": "npm run -w @tikz-editor/web test:e2e:ci --",
    "test:desktop:e2e": "npm run -w @tikz-editor/desktop test:e2e --"
  },
  "keywords": [
    "tikz",
    "lezer",
    "parser"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint-react/eslint-plugin": "^5.8.5",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/eslint-plugin": "^1.6.16",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.5.0",
    "typescript-eslint": "^8.59.1",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "keynote-clipboard": "^1.2.0"
  }
}
