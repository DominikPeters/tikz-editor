@top TikzFile { TikzInline | (BodyItem* TikzEnvironment)+ BodyItem* | BodyItem* }

@skip { space }

@precedence {
  childContinuation,
  childBare,
  picGrouped,
  picOptionOnly,
  pgfMathSemicolon,
  overlayContinuation,
  plotInputGroup,
  plotInputOptions,
  plotInputName,
  pgfplotsSemicolon
}

TikzEnvironment {
  BeginTikz Comment* (OptionList pictureItem* | bodyStart pictureItem*)? EndTikz
}

bodyStart { Statement | StrayToken | UnknownEnvironmentStatement | AxisStatement | PgfEnvironmentStatement }

// An item of a picture's body (a tikzpicture, scope, \tikz or overlay body).
// Only here is an unknown environment a statement: around a picture, in a
// document's preamble or body, `\begin{document}` or `\begin{figure}` would
// otherwise swallow the pictures and definitions inside it.
pictureItem { BodyItem | UnknownEnvironmentStatement | AxisStatement | PgfEnvironmentStatement }

BodyItem {
  Comment |
  Statement |
  StrayToken
}

TikzInline {
  InlineTikzCmd Comment* (OptionList pictureItem* | bodyStart pictureItem*)?
}

Statement {
  ScopeStatement |
  ForeachStatement |
  PathStatement |
  OverlayGroupStatement |
  OverlayDeclarationStatement |
  FontSizeStatement |
  StyleDefinitionStatement |
  TikzLibraryStatement |
  ColorletStatement |
  DefineColorStatement |
  MacroDefinitionStatement |
  MacroAliasStatement |
  MacroCommandDefinitionStatement |
  PgfMathStatement |
  PgfplotsSetStatement |
  UsePgfplotsLibraryStatement |
  PgfplotsTableReadStatement |
  TexLengthStatement |
  PgfLayerStatement |
  UnknownStatement
}

// LaTeX length registers: `\newlength{\a}`, `\setlength{\a}{0.4\textwidth}`, `\addtolength`.
TexLengthStatement {
  NewLengthCmd (Group | CommandName) |
  (SetLengthCmd | AddToLengthCmd) (Group | CommandName) Group
}

StyleDefinitionStatement {
  TikzSetStatement |
  TikzStyleStatement |
  PgfkeysStatement
}

ScopeStatement {
  BeginScope Comment* (OptionList pictureItem* | bodyStart pictureItem*)? EndScope
}

// PGF's environments in a picture: `{pgfonlayer}{name}`, `{pgfscope}`,
// `{pgfinterruptboundingbox}`, `{pgftransparencygroup}[options]`,
// `{pgflowlevelscope}{code}`, `{pgfviewboxscope}{..}{..}{..}{..}{meet}`, and
// their plain TeX and ConTeXt forms. The begin token holds the arguments
// (pgf-environment-tokens.ts); the body is picture statements.
PgfEnvironmentStatement {
  BeginPgfEnvironment pictureItem* EndPgfEnvironment
}

// `\pgfdeclarelayer{name}` and `\pgfsetlayers{list}`.
PgfLayerStatement {
  (PgfDeclareLayerCmd | PgfSetLayersCmd) Group
}

// The generic environment fallback: `\begin{x}…\end{x}` for an environment
// without a rule of its own, as one token (environment-tokens.ts). A rule for
// a specific environment takes it out of the fallback there.
UnknownEnvironmentStatement {
  UnknownEnvironment |
  UnterminatedUnknownEnvironment
}

// pgfplots' axis environments (pgfplots-tokens.ts names them). The body
// holds the axis commands as well as every picture statement. Later axis
// environments, `groupplot` or `polaraxis`, join BeginAxis and EndAxis.
AxisStatement {
  BeginAxis Comment* (OptionList axisItem* | axisBodyStart axisItem*)? EndAxis
}

axisBodyStart { bodyStart | axisCommand }

axisItem { pictureItem | axisCommand }

axisCommand {
  AddPlotStatement |
  AddLegendEntryStatement |
  AddLegendImageStatement |
  LegendStatement |
  PgfplotsExtraStatement |
  PgfplotsInvokeForeachStatement |
  AxisLabelStatement |
  AxisFontEnvironment |
  AxisScopeStatement
}

// `\begin{scope}[options] … \end{scope}` inside an axis body, at any depth:
// its body holds axis commands too (behaviour AC5). pgfplots-tokens.ts reads
// `\begin{scope}` as BeginAxisScope only where an axis item can start, so a
// scope in a plain picture stays a ScopeStatement.
AxisScopeStatement {
  BeginAxisScope Comment* (OptionList axisItem* | axisBodyStart axisItem*)? EndScope
}

// `\pgfplotsinvokeforeach{list}{body with #1}` (manual, utility commands).
PgfplotsInvokeForeachStatement {
  PgfplotsInvokeForeachCmd Comment* Group Comment* Group
}

// `\label{name}` after a plot (for `\ref` in the text): one argument, no `;`.
AxisLabelStatement {
  AxisLabelCmd Group
}

// `\begin{scriptsize}…\end{scriptsize}` (any font size environment) around axis items.
AxisFontEnvironment {
  BeginAxisFontEnv axisItem* EndAxisFontEnv
}

// `\addplot[options] <input> <trailing path>;`, `\addplot+` and `\addplot3`.
AddPlotStatement {
  addPlotHead plotInput AddPlotTrailingPath? (";" | insertPlotSemicolon)
}

addPlotHead {
  (AddPlotCmd | AddPlot3Cmd) AddPlotIncrement? Comment* (OptionList Comment*)* AddPlotLegacyPlot?
}

// The older `\addplot[style] plot[options] <input>`, which the manual still uses.
AddPlotLegacyPlot { PlotKw Comment* (OptionList Comment*)? }

// Path operations after the input, continuing the plot's path: `\closedcycle`, `-- (1,0)`, `node[pos=1]{…}`.
AddPlotTrailingPath { PathItem+ }

AddPlotIncrement { "+" }

plotInput {
  PlotCoordinates |
  PlotExpression |
  PlotParametric |
  PlotTable |
  PlotKeywordInput
}

PlotCoordinates { CoordinatesKw Comment* Group }

// The expression is one raw token (pgfplots-tokens.ts): pgfmath text such as
// `{(x<=40)*2}` or an unclosed `(` (which pgfmath accepts) is not TikZ syntax.
PlotExpression { PlotExpressionData }

PlotParametric { Coordinate }

// Inline table data is one raw token: rows and columns are whitespace- and
// newline-separated, which the grammar's tokens do not keep.
PlotTable {
  TableKw Comment* (OptionList Comment*)? (FromKw Comment*)? (TableData | CommandName)
}

// Any other input named by words: `expression {…}`, `gnuplot [opts] {…}`,
// `function {…}`, `file {…}`, `shell {…}`, `graphics {…}`, `fill between [opts]`.
PlotKeywordInput {
  PlotInputName (!plotInputName PlotInputName)* (!plotInputOptions OptionList)? (!plotInputGroup Group)?
}

PlotInputName { Identifier }

AddLegendEntryStatement {
  AddLegendEntryCmd Comment* (OptionList Comment*)? NodeTextGroup (!pgfplotsSemicolon ";")?
}

AddLegendImageStatement {
  AddLegendImageCmd Comment* StylePayload (!pgfplotsSemicolon ";")?
}

LegendStatement {
  LegendCmd Comment* Group (!pgfplotsSemicolon ";")?
}

PgfplotsExtraStatement {
  PgfplotsExtraCmd Comment* Group (!pgfplotsSemicolon ";")?
}

PgfplotsSetStatement {
  PgfplotsSetCmd StylePayload
}

UsePgfplotsLibraryStatement {
  UsePgfplotsLibraryCmd Group
}

// `\pgfplotstableread[options]{file name or inline rows}\macro`: the data is raw (newlines kept).
PgfplotsTableReadStatement {
  PgfplotsTableReadCmd Comment* (OptionList Comment*)? TableData Comment* CommandName
}

ForeachStatement {
  (ForeachCmd | PgfplotsForeachUngroupedCmd) ForeachHeaderToken* InKw ForeachList ForeachBody
}

ForeachBody {
  Group |
  Statement
}

ForeachHeaderToken {
  Comment |
  OptionList |
  Coordinate |
  PathKeyword |
  FontSizeCmd |
  EscapedBraceOpenCmd |
  EscapedBraceCloseCmd |
  ControlSymbolCmd |
  CommandName |
  IdentifierLike |
  Number |
  OptionPunct
}

ForeachList {
  Group |
  Coordinate |
  FontSizeCmd |
  ControlSymbolCmd |
  CommandName |
  IdentifierLike
}

// Beamer overlay specifications, read where PGF reads them
// (tikz.code.tex, \tikz@path@overlay and \tikz@command@path): straight after
// a path command's name, and after \path's first option list. The grammar
// takes it after any command's first option list; the AST refuses it for the
// shorthands, which are \path[…] to PGF (\draw[red]<2> is an error there).
PathStatement {
  PicPathStatement |
  NodePathStatement |
  PathCommand OverlaySpec? PathItem* statementEnd |
  PathCommand OptionList OverlaySpec PathItem* statementEnd
}

// A statement's `;`, or its absence right before `\end{axis}` (pgfplots-tokens.ts).
statementEnd { ";" | insertSemicolon }

PicPathStatement {
  PicCmd OverlaySpec? PicForeachClause* PicQualifier* Group? statementEnd
}

NodePathStatement {
  NodeCmd OverlaySpec? NodeCommandItem* statementEnd
}

// Beamer's overlay commands at statement level. Their braces delimit an
// argument, not a TeX group; \onslide without braces and \pause are
// declarations that hold to the end of the enclosing scope.
OverlayGroupStatement {
  OverlayGroupCmd OverlaySpec OverlayBody (!overlayContinuation OverlayBody)* |
  OnslideCmd OverlayModifier? OverlaySpec !overlayContinuation OverlayBody
}

OverlayDeclarationStatement {
  OnslideCmd OverlayModifier? OverlaySpec? |
  PauseCmd (!overlayContinuation OptionList)?
}

OverlayModifier {
  !overlayContinuation ("*" | "+")
}

OverlayBody {
  "{" pictureItem* !overlayContinuation "}"
}

PathCommand {
  GraphCmd |
  DrawCmd |
  PathCmd |
  FillDrawCmd |
  FillCmd |
  PatternCmd |
  ClipCmd |
  ShadeCmd |
  ShadeDrawCmd |
  UseAsBoundingBoxCmd |
  MatrixCmd |
  CoordinateCmd
}

NodeCommandItem {
  PathForeachOperation |
  ToOperation |
  EdgeOperation |
  ChildOperation |
  EdgeFromParentOperation |
  SvgOperation |
  LetOperation |
  CoordinateOperation |
  DecorateOperation |
  PicOperation |
  NodeItem |
  Comment |
  OptionList |
  RelativeCoordinate |
  Coordinate |
  PathKeyword |
  NodeTextGroup |
  PathOperator |
  UnknownPathItem
}

PathItem {
  PathForeachOperation |
  ToOperation |
  EdgeOperation |
  ChildOperation |
  EdgeFromParentOperation |
  SvgOperation |
  LetOperation |
  CoordinateOperation |
  DecorateOperation |
  PicOperation |
  Comment |
  RelativeCoordinate |
  Coordinate |
  NodeItem |
  OptionList |
  PathOperator |
  PathKeyword |
  Group |
  UnknownPathItem
}

PathOperator {
  "--" |
  "-|" |
  "|-" |
  ".." |
  ","
}

NodeItem {
  NodeKw NodeForeachClause* NodeQualifier* NodeTextGroup
}

NodeForeachClause {
  ForeachKw ForeachHeaderToken* InKw ForeachList
}

NodeQualifier {
  OptionList |
  NodePlacement |
  NodeName
}

NodePlacement {
  AtKw CoordinateLike
}

NodeName {
  Coordinate
}

PicOperation {
  PicKw PicForeachClause* OptionList? !picGrouped PicPlacement? Group |
  PicKw PicForeachClause* OptionList !picOptionOnly
}

PicForeachClause {
  (ForeachKw | ForeachCmd) ForeachHeaderToken* InKw ForeachList
}

PicQualifier {
  OptionList |
  PicPlacement |
  PicName
}

PicPlacement {
  AtKw CoordinateLike
}

PicName {
  Coordinate
}

CoordinateLike {
  RelativeCoordinate |
  Coordinate
}

RelativeCoordinate {
  RelativePrefix Coordinate
}

RelativePrefix {
  "++" |
  "+"
}

PathKeyword {
  AtKw |
  BendKw |
  CycleKw |
  CircleKw |
  ControlsKw |
  AndKw |
  RectangleKw |
  EllipseKw |
  ArcKw |
  GridKw |
  PlotKw |
  CoordinatesKw |
  ParabolaKw |
  SinKw |
  CosKw
}

ToOperation {
  ToKw OptionList? (NodeItem | PicOperation)* ToTarget
}

EdgeOperation {
  EdgeKw OptionList? (NodeItem | PicOperation)* ToTarget
}

ChildOperation {
  ChildKw !childContinuation (OptionList ChildForeachClause* Group? | ChildForeachClause+ Group? | Group) |
  ChildKw !childBare
}

ChildForeachClause {
  (ForeachKw | ForeachCmd) ForeachHeaderToken* InKw ForeachList
}

EdgeFromParentOperation {
  EdgeKw ((FromKw ParentKw) | (ToKw ParentKw)) OptionList? NodeItem
}

PathForeachOperation {
  (ForeachKw | ForeachCmd) ForeachHeaderToken* InKw ForeachList Group
}

ToTarget {
  CoordinateLike |
  CycleKw
}

SvgOperation {
  SvgKw OptionList? SvgPayload
}

SvgPayload {
  Group |
  QuotedSvg
}

LetOperation {
  LetKw LetPart* InKw
}

LetPart {
  Comment |
  RelativeCoordinate |
  Coordinate |
  OptionList |
  Group |
  PathKeyword |
  KnownCommand |
  ControlSymbolCmd |
  CommandName |
  IdentifierLike |
  Number |
  LetPunct |
  StraySymbol
}

LetPunct {
  "," |
  "="
}

CoordinateOperation {
  CoordinateKw OptionList? Coordinate
}

DecorateOperation {
  DecorateKw OptionList? Group
}

UnknownStatement {
  CommandName UnknownPart* statementEnd
}

UnknownPart {
  Comment |
  RelativeCoordinate |
  Coordinate |
  OptionList |
  Group |
  PathOperator |
  PathKeyword |
  NodeKw |
  ToKw |
  EdgeKw |
  ChildKw |
  FromKw |
  ParentKw |
  SvgKw |
  LetKw |
  InKw |
  CoordinateKw |
  DecorateKw |
  PicKw |
  ForeachKw |
  ForeachCmd |
  QuotedSvg |
  "=" |
  UnknownPathItem
}

FontSizeStatement {
  FontSizeCmd
}

PgfMathStatement {
  (PgfMathSetMacroCmd | PgfMathTruncateMacroCmd) (Group | CommandName) Group (!pgfMathSemicolon ";")? |
  PgfMathParseCmd Group (!pgfMathSemicolon ";")? |
  PgfMathSetSeedCmd Group (!pgfMathSemicolon ";")?
}

TikzSetStatement {
  TikzSetCmd StylePayload (!pgfMathSemicolon ";")?
}

TikzStyleStatement {
  TikzStyleCmd (Group | IdentifierLike) ("+"? "=") (OptionList | StylePayload)
}

PgfkeysStatement {
  PgfkeysCmd StylePayload
}

ColorletStatement {
  ColorletCmd Group Group
}

DefineColorStatement {
  DefineColorCmd Group Group Group
}

TikzLibraryStatement {
  UseTikzLibraryCmd Group
}

MacroDefinitionStatement {
  DefCmd CommandName DefParameterText? Group |
  // `\expandafter\def\expandafter\name\expandafter{\other}`: \name gets the first expansion of \other.
  ExpandAfterCmd DefCmd ExpandAfterCmd CommandName ExpandAfterCmd Group
}

// TeX's parameter text of \def: `#1#2` (delimited parameters are not supported).
DefParameterText {
  DefParameter+
}

MacroAliasStatement {
  LetDefCmd CommandName LetAliasTarget
}

LetAliasTarget {
  "="? (CommandName | Group)
}

MacroCommandDefinitionStatement {
  ((NewCommandCmd | RenewCommandCmd | ProvideCommandCmd | DeclareRobustCommandCmd) "*"?
    MacroCommandName
    MacroCommandArityClause?
    Group) |
  (DeclareMathOperatorCmd "*"?
    MacroCommandName
    Group)
}

MacroCommandArityClause {
  MacroCommandArity
  MacroCommandDefaultArg?
}

MacroCommandName {
  CommandName |
  Group
}

MacroCommandArity {
  "[" Number "]"
}

MacroCommandDefaultArg {
  "[" MacroCommandDefaultArgPart* "]"
}

MacroCommandDefaultArgPart {
  Comment |
  Group |
  Coordinate |
  OptionList |
  GroupPathOperator |
  MatrixRowSepCmd |
  EscapedAmpersandCmd |
  EscapedPercentCmd |
  EscapedDollarCmd |
  EscapedBraceOpenCmd |
  EscapedBraceCloseCmd |
  EscapedSpaceCmd |
  EscapedParenOpenCmd |
  EscapedParenCloseCmd |
  PathKeyword |
  KnownCommand |
  ControlSymbolCmd |
  CommandName |
  ToKw |
  EdgeKw |
  ChildKw |
  FromKw |
  ParentKw |
  SvgKw |
  LetKw |
  InKw |
  CoordinateKw |
  DecorateKw |
  PicKw |
  Number |
  IdentifierLike |
  GroupPunct
}

UnknownPathItem {
  KnownCommand |
  ControlSymbolCmd |
  CommandName |
  IdentifierLike |
  Number |
  StraySymbol
}

OptionList {
  "[" OptionPart* "]"
}

OptionPart {
  Comment |
  Group |
  QuotedSvg |
  Coordinate |
  GroupPathOperator |
  PathKeyword |
  // pgfplots' `row sep=\\`.
  MatrixRowSepCmd |
  EscapedAmpersandCmd |
  EscapedPercentCmd |
  EscapedDollarCmd |
  EscapedBraceOpenCmd |
  EscapedBraceCloseCmd |
  EscapedSpaceCmd |
  EscapedParenOpenCmd |
  EscapedParenCloseCmd |
  KnownCommand |
  ControlSymbolCmd |
  CommandName |
  NodeKw |
  ToKw |
  ChildKw |
  FromKw |
  ParentKw |
  EdgeKw |
  SvgKw |
  LetKw |
  InKw |
  CoordinateKw |
  DecorateKw |
  PicKw |
  IdentifierLike |
  Number |
  OptionPunct
}

OptionPunct {
  "," |
  "=" |
  ":" |
  "/" |
  "." |
  "-" |
  "+" |
  "|" |
  "!" |
  "?" |
  ">" |
  "<" |
  "'" |
  "$" |
  "^" |
  "_" |
  "~" |
  "*" |
  "#" |
  "&" |
  "@"
}

Group {
  "{" GroupPart* "}"
}

NodeTextGroup {
  "{" NodeTextPart* "}"
}

NodeTextPart {
  Comment |
  NodeTextGroup |
  NodeTextDollarMath |
  MatrixRowSepCmd |
  EscapedAmpersandCmd |
  EscapedPercentCmd |
  EscapedDollarCmd |
  EscapedBraceOpenCmd |
  EscapedBraceCloseCmd |
  EscapedSpaceCmd |
  EscapedParenOpenCmd |
  EscapedParenCloseCmd |
  EscapedBracketOpenCmd |
  EscapedBracketCloseCmd |
  KnownCommand |
  ControlSymbolCmd |
  CommandName |
  NodeTextChunk |
  NodeTextPunct
}

NodeTextDollarMath {
  DoubleDollar NodeTextMathPart* DoubleDollar |
  Dollar NodeTextMathPart* Dollar
}

NodeTextMathPart {
  Comment |
  NodeTextGroup |
  MatrixRowSepCmd |
  EscapedAmpersandCmd |
  EscapedPercentCmd |
  EscapedDollarCmd |
  EscapedBraceOpenCmd |
  EscapedBraceCloseCmd |
  EscapedSpaceCmd |
  EscapedParenOpenCmd |
  EscapedParenCloseCmd |
  KnownCommand |
  ControlSymbolCmd |
  CommandName |
  NodeTextChunk |
  NodeTextPunct
}

StylePayload {
  "{" StylePayloadPart* "}"
}

GroupPart {
  Comment |
  "]" |
  ScopeStatement |
  PgfMathStatement |
  Group |
  GroupCoordinate |
  OptionList |
  GroupPathOperator |
  MatrixRowSepCmd |
  EscapedAmpersandCmd |
  EscapedPercentCmd |
  EscapedDollarCmd |
  EscapedBraceOpenCmd |
  EscapedBraceCloseCmd |
  EscapedSpaceCmd |
  EscapedParenOpenCmd |
  EscapedParenCloseCmd |
  PathKeyword |
  ForeachCmd |
  ForeachKw |
  KnownCommand |
  NodeKw |
  PicKw |
  ControlSymbolCmd |
  CommandName |
  ExpandAfterCmd |
  DefCmd |
  LetDefCmd |
  ToKw |
  EdgeKw |
  ChildKw |
  FromKw |
  ParentKw |
  SvgKw |
  LetKw |
  InKw |
  CoordinateKw |
  DecorateKw |
  Number |
  IdentifierLike |
  GroupPunct
}

StylePayloadPart {
  Comment |
  "]" |
  StylePayload |
  Coordinate |
  OptionList |
  PathKeyword |
  MatrixRowSepCmd |
  EscapedAmpersandCmd |
  EscapedPercentCmd |
  EscapedDollarCmd |
  EscapedBraceOpenCmd |
  EscapedBraceCloseCmd |
  EscapedParenOpenCmd |
  EscapedParenCloseCmd |
  KnownCommand |
  ControlSymbolCmd |
  CommandName |
  NodeKw |
  PicKw |
  ToKw |
  ChildKw |
  FromKw |
  ParentKw |
  SvgKw |
  LetKw |
  InKw |
  CoordinateKw |
  DecorateKw |
  Number |
  IdentifierLike |
  OptionPunct
}

GroupPathOperator {
  "--" |
  "++" |
  "-|" |
  "|-" |
  ".."
}

GroupPunct {
  "," |
  "." |
  ":" |
  ";" |
  "!" |
  "?" |
  "-" |
  "+" |
  "/" |
  "=" |
  "|" |
  "&" |
  "^" |
  "$" |
  "_" |
  "~" |
  "*" |
  "#" |
  "'" |
  ">" |
  "<" |
  "\"" |
  "`"
}

Coordinate {
  "(" CoordPart* ")"
}

// A parenthesised run inside braces: besides coordinates, pgfmath
// (`{(x<=40)*2}`) and math text (`{$I(X;L)$}`) put `;`, `<`, `>`, `?` there.
GroupCoordinate[@name=Coordinate] {
  "(" GroupCoordPart* ")"
}

GroupCoordPart[@name=CoordPart] {
  GroupCoordinate | coordPartBase | ";" | "<" | ">" | "?" | "~" | "\"" | "`" | "@"
}

  CoordPart {
  Coordinate |
  coordPartBase
}

coordPartBase {
  OptionList |
  Group |
  GroupPathOperator |
  PathKeyword |
  EscapedPercentCmd |
  EscapedDollarCmd |
  EscapedBraceOpenCmd |
  EscapedBraceCloseCmd |
  EscapedParenOpenCmd |
  EscapedParenCloseCmd |
  KnownCommand |
  ControlSymbolCmd |
  CommandName |
  ToKw |
  ChildKw |
  FromKw |
  ParentKw |
  SvgKw |
  LetKw |
  InKw |
  CoordinateKw |
  DecorateKw |
  NodeKw |
  PicKw |
  Number |
  IdentifierLike |
  "," |
  "." |
  ":" |
  "-" |
  "+" |
  "/" |
  "=" |
  "$" |
  "!" |
  "*" |
  "|" |
  "&" |
  "^" |
  "_" |
  "#" |
  "'"
}

IdentifierLike {
  Identifier |
  OfKw |
  TableKw
}

KnownCommand {
  GraphCmd |
  DrawCmd |
  PathCmd |
  FillDrawCmd |
  FillCmd |
  PatternCmd |
  ClipCmd |
  ShadeCmd |
  ShadeDrawCmd |
  UseAsBoundingBoxCmd |
  MatrixCmd |
  NodeCmd |
  PicCmd |
  CoordinateCmd |
  FontSizeCmd |
  OverlayGroupCmd |
  OnslideCmd |
  PauseCmd
}

StraySymbol {
  "*" |
  "!" |
  "?" |
  "'" |
  "\"" |
  "$" |
  "|" |
  "&" |
  "^" |
  "_" |
  "~" |
  "@"
}

StrayToken {
  Number |
  ToKw |
  ChildKw |
  FromKw |
  ParentKw |
  SvgKw |
  LetKw |
  InKw |
  CoordinateKw |
  DecorateKw |
  PicKw |
  IdentifierLike |
  PathKeyword |
  "{" |
  "}" |
  "]" |
  "(" |
  ")" |
  "," |
  ";" |
  ":" |
  "." |
  "=" |
  "-" |
  "+" |
  "/" |
  StraySymbol
}

// Word keywords specialize Identifier so they only match as whole words.
AtKw { @specialize<Identifier, "at"> }
InlineTikzCmd { @specialize<CommandName, "\\tikz"> }
// Whole command names only: \altitude is not \alt.
OverlayGroupCmd {
  @specialize<CommandName, "\\only"> |
  @specialize<CommandName, "\\uncover"> |
  @specialize<CommandName, "\\visible"> |
  @specialize<CommandName, "\\invisible"> |
  @specialize<CommandName, "\\alt"> |
  @specialize<CommandName, "\\temporal">
}
OnslideCmd { @specialize<CommandName, "\\onslide"> }
PauseCmd { @specialize<CommandName, "\\pause"> }
BendKw { @specialize<Identifier, "bend"> }
CycleKw { @specialize<Identifier, "cycle"> }
CircleKw { @specialize<Identifier, "circle"> }
ToKw { @specialize<Identifier, "to"> }
ChildKw { @specialize<Identifier, "child"> }
FromKw { @specialize<Identifier, "from"> }
ParentKw { @specialize<Identifier, "parent"> }
SvgKw { @specialize<Identifier, "svg"> }
LetKw { @specialize<Identifier, "let"> }
InKw { @specialize<Identifier, "in"> }
OfKw { @specialize<Identifier, "of"> }
CoordinateKw { @specialize<Identifier, "coordinate"> }
CoordinatesKw { @specialize<Identifier, "coordinates"> }
DecorateKw { @specialize<Identifier, "decorate"> }
EdgeKw { @specialize<Identifier, "edge"> }
ControlsKw { @specialize<Identifier, "controls"> }
AndKw { @specialize<Identifier, "and"> }
RectangleKw { @specialize<Identifier, "rectangle"> }
EllipseKw { @specialize<Identifier, "ellipse"> }
ArcKw { @specialize<Identifier, "arc"> }
GridKw { @specialize<Identifier, "grid"> }
PlotKw { @specialize<Identifier, "plot"> }
ParabolaKw { @specialize<Identifier, "parabola"> }
SinKw { @specialize<Identifier, "sin"> }
CosKw { @specialize<Identifier, "cos"> }
NodeKw { @specialize<Identifier, "node"> }
PicKw { @specialize<Identifier, "pic"> }
ForeachKw { @specialize<Identifier, "foreach"> }
TableKw { @specialize<Identifier, "table"> }

@external tokens pgfplotsTokens from "./pgfplots-tokens.js" {
  BeginAxis,
  EndAxis,
  AddPlotCmd,
  AddPlot3Cmd,
  AddLegendEntryCmd,
  AddLegendImageCmd,
  LegendCmd,
  PgfplotsSetCmd,
  PgfplotsExtraCmd,
  UsePgfplotsLibraryCmd,
  PgfplotsInvokeForeachCmd,
  PgfplotsForeachUngroupedCmd,
  PgfplotsTableReadCmd,
  AxisLabelCmd,
  BeginAxisFontEnv,
  EndAxisFontEnv,
  BeginAxisScope,
  TableData,
  PlotExpressionData,
  insertSemicolon,
  insertPlotSemicolon,
  BeginPgfEnvironment,
  EndPgfEnvironment,
  PgfDeclareLayerCmd,
  PgfSetLayersCmd
}

@external tokens unknownEnvironmentTokens from "./environment-tokens.js" {
  UnknownEnvironment,
  UnterminatedUnknownEnvironment
}

@tokens {
  @precedence {
    BeginTikz,
    DoubleDollar,
    TikzSetCmd,
    TikzStyleCmd,
    DefineColorCmd,
    DefCmd,
    ExpandAfterCmd,
    ColorletCmd,
    LetDefCmd,
    NewCommandCmd,
    RenewCommandCmd,
    ProvideCommandCmd,
    DeclareRobustCommandCmd,
    DeclareMathOperatorCmd,
    PgfMathSetMacroCmd,
    PgfMathTruncateMacroCmd,
    NewLengthCmd,
    SetLengthCmd,
    AddToLengthCmd,
    PgfMathParseCmd,
    PgfMathSetSeedCmd,
    EndTikz,
    FillDrawCmd,
    FillCmd,
    PatternCmd,
    DrawCmd,
    GraphCmd,
    PathCmd,
    ClipCmd,
    ShadeDrawCmd,
    ShadeCmd,
    UseAsBoundingBoxCmd,
    BeginScope,
    EndScope,
    ForeachCmd,
    MatrixCmd,
    NodeCmd,
    PicCmd,
    CoordinateCmd,
    PgfkeysCmd,
    UseTikzLibraryCmd,
    MatrixRowSepCmd,
    EscapedAmpersandCmd,
    EscapedPercentCmd,
    EscapedDollarCmd,
    EscapedBraceOpenCmd,
    EscapedBraceCloseCmd,
    EscapedSpaceCmd,
    EscapedParenOpenCmd,
    EscapedParenCloseCmd,
    EscapedBracketOpenCmd,
    EscapedBracketCloseCmd,
    ControlSymbolCmd,
    FontSizeCmd,
    CommandName,
    Dollar,
    Number,
    ".",
    Identifier,
    Comment,
    space
  }

  space { $[ \t\n\r]+ }

  Comment { "%" ![\n\r]* }

  BeginTikz { "\\begin{tikzpicture}" | "\\begin{tikzpicture*}" | "\\begin{tikzlayer}" }
  EndTikz { "\\end{tikzpicture}" | "\\end{tikzpicture*}" | "\\end{tikzlayer}" }

  DrawCmd { "\\draw" }
  GraphCmd { "\\graph" }
  PathCmd { "\\path" }
  FillDrawCmd { "\\filldraw" }
  FillCmd { "\\fill" }
  PatternCmd { "\\pattern" }
  ClipCmd { "\\clip" }
  ShadeCmd { "\\shade" }
  ShadeDrawCmd { "\\shadedraw" }
  UseAsBoundingBoxCmd { "\\useasboundingbox" }
  MatrixCmd { "\\matrix" }
  BeginScope { "\\begin{scope}" }
  EndScope { "\\end{scope}" }
  OverlaySpec { "<" ![<>{}\n\r]* ">" }
  ForeachCmd { "\\foreach" }
  NodeCmd { "\\node" }
  PicCmd { "\\pic" }
  CoordinateCmd { "\\coordinate" }
  TikzSetCmd { "\\tikzset" }
  TikzStyleCmd { "\\tikzstyle" }
  DefCmd { "\\def" }
  ExpandAfterCmd { "\\expandafter" }
  DefParameter { "#" $[1-9] }
  ColorletCmd { "\\colorlet" }
  DefineColorCmd { "\\definecolor" }
  LetDefCmd { "\\let" }
  NewCommandCmd { "\\newcommand" }
  RenewCommandCmd { "\\renewcommand" }
  ProvideCommandCmd { "\\providecommand" }
  DeclareRobustCommandCmd { "\\DeclareRobustCommand" }
  DeclareMathOperatorCmd { "\\DeclareMathOperator" }
  PgfMathSetMacroCmd { "\\pgfmathsetmacro" }
  PgfMathTruncateMacroCmd { "\\pgfmathtruncatemacro" }
  NewLengthCmd { "\\newlength" }
  SetLengthCmd { "\\setlength" }
  AddToLengthCmd { "\\addtolength" }
  PgfMathParseCmd { "\\pgfmathparse" }
  PgfMathSetSeedCmd { "\\pgfmathsetseed" }
  PgfkeysCmd { "\\pgfkeys" }
  UseTikzLibraryCmd { "\\usetikzlibrary" }
  MatrixRowSepCmd { "\\\\" }
  EscapedAmpersandCmd { "\\&" }
  EscapedPercentCmd { "\\%" }
  EscapedDollarCmd { "\\$" }
  EscapedBraceOpenCmd { "\\{" }
  EscapedBraceCloseCmd { "\\}" }
  EscapedSpaceCmd { "\\ " }
  EscapedParenOpenCmd { "\\(" }
  EscapedParenCloseCmd { "\\)" }
  EscapedBracketOpenCmd { "\\[" }
  EscapedBracketCloseCmd { "\\]" }
  ControlSymbolCmd {
    "\\," |
    "\\!" |
    "\\;" |
    "\\:" |
    "\\." |
    "\\?" |
    "\\/" |
    "\\|" |
    "\\+" |
    "\\-" |
    "\\=" |
    "\\*" |
    "\\'" |
    "\\\"" |
    "\\`" |
    "\\~" |
    "\\^" |
    "\\_" |
    "\\#"
  }

  FontSizeCmd {
    "\\tiny" |
    "\\scriptsize" |
    "\\footnotesize" |
    "\\small" |
    "\\normalsize" |
    "\\large" |
    "\\Large" |
    "\\LARGE" |
    "\\huge" |
    "\\Huge"
  }

  CommandName { "\\" $[A-Za-z@]+ }

  DoubleDollar { "$$" }

  Dollar { "$" }

  Number { ($[0-9]+ ("." $[0-9]*)? | "." $[0-9]+) ($[eE] $[+\-]? $[0-9]+)? }

  Identifier { $[A-Za-z] $[-A-Za-z0-9_:@]* }

  NodeTextChunk { ![\\{}$%&^_~#\[\](),.;:!?'"`=+\-*/|<>\n\r \t]+ }

  NodeTextPunct { $[&^_~#\[\](),.;:!?'"`=+\-*/|<>] }

  QuotedSvg { "\"" !["\n\r]* "\"" }
}
