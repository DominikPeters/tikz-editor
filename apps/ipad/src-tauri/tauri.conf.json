{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TikZ Editor",
  "version": "1.1.0",
  "identifier": "dev.tikz.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1422",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "TikZ Editor",
        "width": 1194,
        "height": 834,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "16.0",
      "bundleVersion": "2",
      "template": "src-tauri/ios-project.yml"
    }
  }
}
