{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mobile-capability",
  "description": "Enables iPad file, dialog, and external URL access for the main editor window.",
  "platforms": ["iOS"],
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$APPDATA" },
        { "path": "$APPDATA/**/*" },
        { "path": "$DOCUMENT" },
        { "path": "$DOCUMENT/**/*" },
        { "path": "$TEMP" },
        { "path": "$TEMP/**/*" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://localhost:*" }
      ]
    }
  ]
}
